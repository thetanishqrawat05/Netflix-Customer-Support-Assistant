# Rename this file to .env and fill in your key.

# LLM provider: "groq" (default, fast + free-tier) or "openai"
LLM_PROVIDER=groq

# Groq API key (get one free at https://console.groq.com/keys)
GROQ_API_KEY=gsk-your-groq-key-here
# Optional: override the default Groq model (default: openai/gpt-oss-120b).
# Check currently available models for your key at https://console.groq.com/docs/models
# LLM_MODEL=openai/gpt-oss-120b

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here

# Mock login credentials for the Streamlit app
APP_USERNAME=admin
APP_PASSWORD=netflix123
